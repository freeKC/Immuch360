{
	"name": "immuch360-webos",
	"version": "0.0.0",
	"description": "Immuch360 for LG webOS TVs: an Immich photo and video viewer with 360 degree photos, built on immich-tv-webos",
	"author": "FreeKC (https://github.com/freeKC)",
	"main": "src/index.tsx",
	"scripts": {
		"serve": "npm run i18n && enact serve",
		"pack": "npm run i18n && enact pack",
		"pack-p": "npm run i18n && enact pack -p && node tools/transpile-legacy.mjs && node tools/prune-ilib.mjs && node tools/build-i18n.mjs --dist dist && node tools/licence-files.mjs dist",
		"ipk": "npm run bridge -- --check && npm run pack-p && node tools/package-ipk.mjs",
		"bridge": "node tools/build-bridge.mjs",
		"set-version": "node tools/set-version.mjs",
		"i18n": "node tools/build-i18n.mjs",
		"check-package": "node tools/check-package.mjs build --list build/ipk-files.json && node tools/check-package.mjs build-1280x720 --list build-1280x720/ipk-files.json --resolution 1280x720",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"lint": "enact lint .",
		"typecheck": "npm run i18n && tsc --noEmit",
		"license": "enact license",
		"test": "npm run i18n && enact test",
		"test-watch": "enact test --watch",
		"test-unit": "npm run i18n && node --import ./tools/ts-hooks.mjs --test \"test/unit/*.test.mjs\"",
		"test-service": "node service/test.js",
		"test-bridge": "node --test \"bridge/test/*.test.cjs\"",
		"test-tools": "node --test tools/legacy-css.test.mjs tools/build-i18n.test.mjs tools/package-ipk.test.mjs"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/freeKC/Immuch360.git",
		"directory": "webos"
	},
	"bugs": {
		"url": "https://github.com/freeKC/Immuch360/issues"
	},
	"homepage": "https://github.com/freeKC/Immuch360/tree/immuch360/webos#readme",
	"keywords": [
		"immich",
		"immuch360",
		"webos",
		"lg",
		"tv",
		"360",
		"panorama",
		"enact",
		"sandstone"
	],
	"engines": {
		"node": ">=24",
		"npm": ">=10"
	},
	"enact": {
		"theme": "sandstone",
		"publicUrl": "./"
	},
	"browserslist": [
		"Chrome >= 79"
	],
	"cssnano": {
		"preset": [
			"default",
			{
				"overrideBrowserslist": "Chrome >= 53"
			}
		]
	},
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"jest": {
		"moduleNameMapper": {
			"^react$": "<rootDir>/node_modules/react/index.js",
			"^react/jsx-runtime$": "<rootDir>/node_modules/react/jsx-runtime.js",
			"^react/jsx-dev-runtime$": "<rootDir>/node_modules/react/jsx-dev-runtime.js",
			"^react-dom$": "<rootDir>/node_modules/react-dom/index.js",
			"^react-dom/client$": "<rootDir>/node_modules/react-dom/client.js",
			"^@testing-library/react$": "<rootDir>/node_modules/@testing-library/react/dist/index.js"
		}
	},
	"dependencies": {
		"@enact/core": "^4.7.8",
		"@enact/i18n": "^4.7.8",
		"@enact/sandstone": "^2.7.12",
		"@enact/spotlight": "^4.7.8",
		"@enact/ui": "^4.7.8",
		"@enact/webos": "^4.7.8",
		"@tanstack/react-query": "^5.90.14",
		"ilib": "npm:ilib-webos@^14.19.0-webos1",
		"prop-types": "^15.8.1",
		"qrcode-generator": "^2.0.4",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@enact/cli": "7.3.4",
		"@testing-library/react": "^16.3.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@webos-tools/cli": "3.2.6",
		"baseline-browser-mapping": "^2.9.14",
		"des.js": "1.1.0",
		"esbuild": "^0.28.0",
		"eslint-config-enact-proxy": "^1.0.7",
		"hash-wasm": "4.12.0",
		"typescript": "^5.9.3"
	},
	"private": true,
	"contributors": [
		"Quentin Jean-Amans (https://github.com/Seeky91), author of immich-tv-webos, the base of this app"
	]
}
