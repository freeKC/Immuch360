<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Meta Horizon Store upload checks: these two permissions are not allowed on the Quest, and the manifest must
       state a GLES version (the Spatial player needs ES 3.0 anyway) -->
  <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />

</manifest>
