<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Meta Horizon Store upload checks: these two permissions are not allowed on the Quest, and the manifest must
       state a GLES version (the Spatial player needs ES 3.0 anyway) -->
  <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

  <!-- Horizon Store submission: every sensitive permission has to be justified, so the headset build keeps only
       what it uses there: photos and videos (mode without a server) and notifications (backup progress).
       Dropped: the legacy storage permissions (inert from Android 13, the headset runs 14), audio files (never
       listed), the location of the media and the device location (Wi-Fi name based server switching, not used
       on the headset) and the camera (the Spatial player's face tracking: the headset has no app camera, the
       player then runs without head tracking, as it already did). The permission requests of the app get an
       immediate refusal for these and every caller already handles it. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
  <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
  <uses-feature android:name="android.hardware.camera.front" tools:node="remove" />
  <uses-feature android:name="android.hardware.camera" tools:node="remove" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <!-- Share this phone on the network is for phones: the headset is the one that reads the share. WAKE_LOCK stays,
       Media3 and WorkManager declare and use it as well. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" tools:node="remove" />

  <!-- No cleartext HTTP on the headset (the Horizon Store security scan flags it); the exceptions are in
       res/xml/network_security_config.xml of this flavour, which replaces the phone one by resource merging -->
  <application android:usesCleartextTraffic="false" tools:replace="android:usesCleartextTraffic">
    <!-- The Horizon Store lists the app for the devices named here (the dashboard has no setting for it). The Quest 3
         and 3S are the measured ones: the headset decoder limits and the 8192x4096 textures of the immersive view were
         checked on them. The Quest 2 and Quest Pro (XR2 Gen 1, slower video decoders) are accepted from build 21
         without a test on a real one: the decoder limits of VideoDecoders.kt were measured on the Quest 3 and are
         optimistic for them, and a video their decoders refuse gets the usual message. The Quest 1 is not accepted
         by the store any more. The phone build declares the same list. -->
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" tools:replace="android:value" />
    <service android:name=".phoneshare.PhoneShareService" tools:node="remove" />
  </application>

</manifest>
