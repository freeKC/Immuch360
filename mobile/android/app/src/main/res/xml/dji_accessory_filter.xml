<?xml version="1.0" encoding="utf-8"?>
<!-- Which USB accessories bring up the DJI link entry. Matching is exact on the attributes that are present, so the
     first entry catches any DJI accessory, whatever its model string is, and the second is the identity string our
     own RC-N3 presented in our capture of 23 October 2026. An accessory nobody has described still reaches the page
     and is logged as a profile of its own rather than ignored. -->
<resources>
  <usb-accessory manufacturer="DJI" />
  <usb-accessory manufacturer="DJI" model="com.dji.logiclink" />
</resources>
