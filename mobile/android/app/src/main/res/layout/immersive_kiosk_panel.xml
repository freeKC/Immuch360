<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk mode of the Meta Quest immersive viewer (KioskSession): the exit notice that passes at the start, then the
     end card of the film or the error card, over a dark sphere where the visitor looks. The texts come from the app,
     in its language. Its size in dp is set in ImmersiveViewerActivity.registerPanels -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/immersive_panel_background"
  android:paddingStart="40dp"
  android:paddingTop="24dp"
  android:paddingEnd="40dp"
  android:paddingBottom="24dp">

  <TextView
    android:id="@+id/immersive_kiosk_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:ellipsize="end"
    android:gravity="center"
    android:lineSpacingMultiplier="1.15"
    android:maxLines="5"
    android:textColor="#FFE8EEFF"
    android:textSize="34sp" />
</FrameLayout>
