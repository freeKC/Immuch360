<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/spherical_video_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black">

  <!-- The spherical surface turns the view with touch drags and with the orientation sensors -->
  <androidx.media3.ui.PlayerView
    android:id="@+id/spherical_video_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shutter_background_color="@android:color/black"
    app:show_buffering="when_playing"
    app:show_shuffle_button="false"
    app:show_subtitle_button="false"
    app:surface_type="spherical_gl_surface_view"
    app:use_artwork="false" />

  <LinearLayout
    android:id="@+id/spherical_video_top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageButton
      android:id="@+id/spherical_video_close"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/spherical_video_close"
      android:src="@drawable/ic_spherical_video_close" />

    <TextView
      android:id="@+id/spherical_video_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:ellipsize="middle"
      android:singleLine="true"
      android:textColor="@android:color/white"
      android:textSize="16sp" />

    <!-- Audio track control: lists the audio tracks (languages, commentary) to pick one. Shown by the activity for a
         video with two audio tracks or more; its description and tooltip come from the activity. -->
    <ImageButton
      android:id="@+id/spherical_video_audio"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="8dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_video_audio_track"
      android:visibility="gone"
      tools:ignore="ContentDescription" />

    <!-- Field of view control: switches between the full sphere and the half sphere (VR180). Its text, description,
         tooltip and state come from the activity; "360°" and "180°" read the same in every language. -->
    <Button
      android:id="@+id/spherical_video_coverage"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginStart="8dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:minWidth="48dp"
      android:minHeight="0dp"
      android:paddingStart="4dp"
      android:paddingTop="0dp"
      android:paddingEnd="4dp"
      android:paddingBottom="0dp"
      android:singleLine="true"
      android:stateListAnimator="@null"
      android:text="360°"
      android:textAllCaps="false"
      android:textColor="@android:color/white"
      android:textSize="16sp"
      android:textStyle="bold"
      tools:ignore="HardcodedText" />

    <!-- 3D control: cycles the stereoscopic layout (regular 360, 3D top and bottom, 3D side by side). Its description,
         tooltip and state come from the activity; "3D" reads the same in every language. -->
    <Button
      android:id="@+id/spherical_video_stereo"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="8dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:minWidth="0dp"
      android:minHeight="0dp"
      android:padding="0dp"
      android:stateListAnimator="@null"
      android:text="3D"
      android:textAllCaps="false"
      android:textColor="@android:color/white"
      android:textSize="16sp"
      android:textStyle="bold"
      tools:ignore="HardcodedText" />
  </LinearLayout>
</FrameLayout>
