<?xml version="1.0" encoding="utf-8"?>
<!-- Info panel of the Meta Quest immersive viewer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/immersive_panel_background"
  android:orientation="vertical"
  android:padding="20dp">

  <TextView
    android:id="@+id/immersive_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFE8EEFF"
    android:textSize="22sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/immersive_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:maxLines="3"
    android:textColor="#FFB0B8CC"
    android:textSize="17sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="@string/immersive_hint"
    android:textColor="#FF8A93A8"
    android:textSize="14sp" />

  <View
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal">

    <!-- 3D layout of the media on screen, shown while a media is loaded. A click (controller ray or hand
         pinch) switches to the next layout: mono, top and bottom, side by side -->
    <Button
      android:id="@+id/immersive_stereo"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_gravity="center_vertical"
      android:layout_marginEnd="12dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAllCaps="false"
      android:textSize="17sp"
      android:visibility="gone" />

    <!-- Field of view of the media on screen, "360°" (full sphere) or "180°" (VR180, front half), shown while a
         media is loaded. A click switches to the other one -->
    <Button
      android:id="@+id/immersive_coverage"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_vertical"
      android:layout_marginEnd="12dp"
      android:maxLines="1"
      android:textAllCaps="false"
      android:textSize="17sp"
      android:visibility="gone" />

    <Button
      android:id="@+id/immersive_play_pause"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="12dp"
      android:text="@string/immersive_pause"
      android:textSize="18sp"
      android:visibility="gone" />

    <Button
      android:id="@+id/immersive_back"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/immersive_back"
      android:textSize="18sp" />
  </LinearLayout>
</LinearLayout>
