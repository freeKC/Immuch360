<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/spatial_video_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black">

  <!-- Draws the synthesised view. Taps show the controls; on a 360° video, drags turn the view and pinches zoom. -->
  <android.opengl.GLSurfaceView
    android:id="@+id/spatial_video_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <ProgressBar
    android:id="@+id/spatial_video_buffering"
    style="?android:attr/progressBarStyleLarge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:indeterminate="true"
    android:visibility="gone" />

  <!-- Diagnostics, only with the debug overlay. Stays on screen when the controls hide. -->
  <TextView
    android:id="@+id/spatial_video_stats"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_marginStart="8dp"
    android:layout_marginTop="72dp"
    android:background="#99000000"
    android:fontFamily="monospace"
    android:padding="6dp"
    android:textColor="@android:color/white"
    android:textSize="11sp"
    android:visibility="gone" />

  <!-- Short messages: camera refused, face lost -->
  <TextView
    android:id="@+id/spatial_video_message"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginStart="48dp"
    android:layout_marginTop="72dp"
    android:layout_marginEnd="48dp"
    android:background="#99000000"
    android:gravity="center"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:textColor="@android:color/white"
    android:textSize="14sp"
    android:visibility="gone" />

  <!-- Controls, shown on tap and hidden after 3 s of playback. Not clickable itself, so taps on empty space reach the
       surface below; the bars keep their own taps. -->
  <FrameLayout
    android:id="@+id/spatial_video_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
      android:id="@+id/spatial_video_top_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clickable="true"
      android:focusable="false"
      android:layout_gravity="top"
      android:background="#66000000"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="8dp">

      <ImageButton
        android:id="@+id/spatial_video_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/spherical_video_close"
        android:src="@drawable/ic_spherical_video_close" />

      <TextView
        android:id="@+id/spatial_video_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

      <!-- Audio track: lists the audio tracks (languages, commentary) to pick one. Shown by the activity for a video
           with two audio tracks or more; its description and tooltip come from the activity. -->
      <ImageButton
        android:id="@+id/spatial_video_audio"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_video_audio_track"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

      <!-- Stereo layout: opens a menu with the six layouts. Its text comes from the activity. -->
      <Button
        android:id="@+id/spatial_video_layout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <!-- Field of view of a 360° video: switches between the full sphere and the half sphere (VR180). Its text,
           "360°" or "180°", comes from the activity, which hides it for flat videos. -->
      <Button
        android:id="@+id/spatial_video_coverage"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

      <Button
        android:id="@+id/spatial_video_recenter"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/spatial_video_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clickable="true"
      android:focusable="false"
      android:layout_gravity="bottom"
      android:background="#66000000"
      android:orientation="vertical"
      android:paddingStart="8dp"
      android:paddingTop="4dp"
      android:paddingEnd="8dp"
      android:paddingBottom="8dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
          android:id="@+id/spatial_video_play_pause"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@android:drawable/ic_media_pause"
          tools:ignore="ContentDescription" />

        <TextView
          android:id="@+id/spatial_video_position"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:fontFamily="monospace"
          android:textColor="@android:color/white"
          android:textSize="13sp" />

        <SeekBar
          android:id="@+id/spatial_video_seek"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1" />

        <TextView
          android:id="@+id/spatial_video_duration"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:textColor="@android:color/white"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Head sensitivity, while head tracking runs -->
        <TextView
          android:id="@+id/spatial_video_sensitivity_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:textColor="@android:color/white"
          android:textSize="13sp" />

        <SeekBar
          android:id="@+id/spatial_video_sensitivity"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:max="35" />

        <!-- Manual viewpoint, from the left eye to the right eye: when head tracking is off, when the face has been
             lost for a few seconds, and with the debug overlay. The activity saves the viewpoint itself and sets the
             slider from it, so the slider does not save its own progress. -->
        <TextView
          android:id="@+id/spatial_video_viewpoint_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:text="L"
          android:textColor="@android:color/white"
          android:textSize="13sp"
          android:visibility="gone"
          tools:ignore="HardcodedText" />

        <SeekBar
          android:id="@+id/spatial_video_viewpoint"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:max="100"
          android:progress="50"
          android:saveEnabled="false"
          android:visibility="gone" />

        <TextView
          android:id="@+id/spatial_video_viewpoint_label_end"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="R"
          android:textColor="@android:color/white"
          android:textSize="13sp"
          android:visibility="gone"
          tools:ignore="HardcodedText" />

        <!-- Debug overlay only: shows the disparity map instead of the video -->
        <CheckBox
          android:id="@+id/spatial_video_disparity"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:buttonTint="@android:color/white"
          android:text="Disparity map"
          android:textColor="@android:color/white"
          android:textSize="13sp"
          android:visibility="gone"
          tools:ignore="HardcodedText" />
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
