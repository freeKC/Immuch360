<?xml version="1.0" encoding="utf-8"?>
<!-- The obstacle alert above the video of the Meta Quest flight view (DjiFlightViewActivity): red, white words, the
     distance or the plain words on the first line, the side or "not confirmed yet" on the second. Shown only while the
     alert is on or says its data stopped, never hidden by A. Information only: nothing here reaches the drone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#FFE53935"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="6dp">

  <TextView
    android:id="@+id/dji_flight_alert_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="30sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/dji_flight_alert_side"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="16sp"
    android:visibility="gone" />
</LinearLayout>
